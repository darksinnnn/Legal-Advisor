# ==============================================================================
# Legal Research Assistant - Environment Configuration
# ==============================================================================

# Groq API Key (Required for RAG Conversational AI)
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Specify Groq model
# Defaults to auto-detecting best available model (e.g. llama-3.3-70b-versatile, qwen/qwen3.8-27b)
# GROQ_MODEL=llama-3.3-70b-versatile

# Flask Server Port (Default: 5000)
PORT=5000
